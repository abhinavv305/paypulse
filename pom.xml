<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.14</version>
        <relativePath/>
    </parent>

    <groupId>com.paypulse</groupId>
    <artifactId>paypulse-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>paypulse-parent</name>
    <description>PayPulse: Production-Grade Modular Monolith Payment Orchestration Platform</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <testcontainers.version>1.19.7</testcontainers.version>
    </properties>

    <modules>
        <module>paypulse-domain</module>
        <module>paypulse-provider-api</module>
        <module>paypulse-provider-stripe</module>
        <module>paypulse-provider-adyen</module>
        <module>paypulse-provider-mock</module>
        <module>paypulse-idempotency</module>
        <module>paypulse-outbox</module>
        <module>paypulse-webhook</module>
        <module>paypulse-reconciliation</module>
        <module>paypulse-web</module>
        <module>paypulse-app</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Project Modules -->
            <dependency>
                <groupId>com.paypulse</groupId>
                <artifactId>paypulse-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paypulse</groupId>
                <artifactId>paypulse-provider-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paypulse</groupId>
                <artifactId>paypulse-provider-stripe</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paypulse</groupId>
                <artifactId>paypulse-provider-adyen</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paypulse</groupId>
                <artifactId>paypulse-provider-mock</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paypulse</groupId>
                <artifactId>paypulse-idempotency</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paypulse</groupId>
                <artifactId>paypulse-outbox</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paypulse</groupId>
                <artifactId>paypulse-webhook</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paypulse</groupId>
                <artifactId>paypulse-reconciliation</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paypulse</groupId>
                <artifactId>paypulse-web</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.1</version>
                    <configuration>
                        <source>21</source>
                        <target>21</target>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.5</version>
                    <configuration>
                        <argLine>-XX:+EnableDynamicAgentLoading</argLine>
                        <includes>
                            <include>**/*Test.java</include>
                            <include>**/*IT.java</include>
                        </includes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
